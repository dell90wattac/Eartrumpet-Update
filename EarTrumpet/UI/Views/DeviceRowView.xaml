<UserControl x:Class="EarTrumpet.UI.Views.DeviceRowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:Theme="clr-namespace:EarTrumpet.UI.Themes"
             xmlns:ctl="clr-namespace:EarTrumpet.UI.Controls"
             xmlns:resx="clr-namespace:EarTrumpet.Properties"
             xmlns:vm="clr-namespace:EarTrumpet.UI.ViewModels"
             IsTabStop="False">
    <!--
        One data flow: the endpoint in use, a list to switch it, and its volume.
        Bound to DevicePickerViewModel, so playback and recording render through
        the same control and behave identically.
    -->
    <Grid Margin="0,8,0,8" Visibility="{Binding HasDevice, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Endpoint name. Click to open the list.  -->
        <Button Grid.Row="0"
                Name="DeviceNameButton"
                Margin="8,0,8,0"
                Height="{DynamicResource Mutable_DeviceTitleCellHeight}"
                AutomationProperties.Name="{Binding Default.AccessibleName}"
                Command="{Binding Toggle}"
                IsEnabled="{Binding CanPick}"
                Style="{StaticResource FlyoutRowButtonStyle}"
                ToolTipService.ToolTip="{x:Static resx:Resources.SwitchDeviceToolTip}">
            <Grid Margin="8,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock FontSize="{DynamicResource Mutable_DeviceKindLabelFontSize}"
                               Theme:Brush.Foreground="GrayText"
                               Text="{Binding KindLabel}" />
                    <TextBlock Style="{StaticResource DeviceTitleTextStyle}"
                               Theme:Brush.Foreground="{Binding (Theme:Brush.Foreground), RelativeSource={RelativeSource AncestorType=Button}}"
                               FontWeight="SemiBold"
                               Text="{Binding Default.DisplayName}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!--  No chevron when there is nothing to switch to.  -->
                <TextBlock Grid.Column="1"
                           Margin="8,0,0,0"
                           FontSize="{DynamicResource Mutable_ExpandCollapseButtonGlyphFontSize}"
                           Style="{StaticResource GlyphTextBlockStyle}"
                           Theme:Brush.Foreground="{Binding (Theme:Brush.Foreground), RelativeSource={RelativeSource AncestorType=Button}}"
                           Text="&#xE70D;"
                           Visibility="{Binding CanPick, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Button>

        <!--  The list, in place rather than in a submenu.  -->
        <Border Grid.Row="1"
                Margin="8,4,8,4"
                Padding="4"
                CornerRadius="{StaticResource ControlCornerRadius}"
                Theme:Brush.Background="Theme=#14FFFFFF, Light=#0A000000, HighContrast=Window"
                Theme:Brush.BorderBrush="Theme=#20FFFFFF, Light=#18000000, HighContrast=WindowText"
                BorderThickness="1"
                Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ItemsControl AutomationProperties.Name="{Binding KindLabel}" ItemsSource="{Binding Devices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DeviceViewModel}">
                        <Button Height="30"
                                Command="{Binding DataContext.Select, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource FlyoutRowButtonStyle}">
                            <Grid Margin="6,0,6,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!--  Checkmark marks the endpoint currently in use.  -->
                                <TextBlock Grid.Column="0"
                                           HorizontalAlignment="Left"
                                           FontSize="12"
                                           Style="{StaticResource GlyphTextBlockStyle}"
                                           Theme:Brush.Foreground="Theme=SystemAccent, HighContrast=Highlight"
                                           Text="&#xE73E;"
                                           Visibility="{Binding IsDefault, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock Grid.Column="1"
                                           Theme:Brush.Foreground="{Binding (Theme:Brush.Foreground), RelativeSource={RelativeSource AncestorType=Button}}"
                                           Text="{Binding DisplayName}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!--  Mute, level, readout.  -->
        <Grid Grid.Row="2"
              Height="{DynamicResource Mutable_DeviceItemCellHeight}"
              Margin="8,0,8,0"
              Visibility="{Binding ShowsVolume, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{DynamicResource Mutable_IconCellWidth}" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{DynamicResource Mutable_VolumeCellWidth}" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Width="30"
                    Height="30"
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="{x:Static resx:Resources.ToggleMuteToolTip}"
                    Background="Transparent"
                    Command="{Binding Default.ToggleMute}"
                    IsTabStop="False"
                    Style="{StaticResource MuteButton}"
                    ToolTipService.ToolTip="{x:Static resx:Resources.ToggleMuteToolTip}">
                <TextBlock FontSize="16"
                           Theme:Brush.Foreground="{Binding (Theme:Brush.Foreground), RelativeSource={RelativeSource AncestorType=Button}}">
                    <TextBlock.Style>
                        <Style BasedOn="{StaticResource GlyphTextBlockStyle}" TargetType="{x:Type TextBlock}">
                            <Setter Property="Text" Value="&#xE995;" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Default.IconKind}" Value="Mute">
                                    <Setter Property="Text" Value="&#xE74F;" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Default.IconKind}" Value="Microphone">
                                    <Setter Property="Text" Value="&#xE720;" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Default.IconKind}" Value="Bar0">
                                    <Setter Property="Text" Value="&#xE992;" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Default.IconKind}" Value="Bar1">
                                    <Setter Property="Text" Value="&#xE993;" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Default.IconKind}" Value="Bar2">
                                    <Setter Property="Text" Value="&#xE994;" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Default.IconKind}" Value="Bar3">
                                    <Setter Property="Text" Value="&#xE995;" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Button>

            <ctl:VolumeSlider Grid.Column="1"
                              AutomationProperties.Name="{Binding Default.DisplayName}"
                              PeakValue1="{Binding Default.PeakValue1}"
                              PeakValue2="{Binding Default.PeakValue2}"
                              PreviewMouseUp="VolumeSlider_MouseUp"
                              PreviewTouchUp="VolumeSlider_TouchUp"
                              Style="{StaticResource {x:Type Slider}}"
                              Value="{Binding Default.Volume, Mode=TwoWay}" />

            <TextBlock Grid.Column="2"
                       Style="{StaticResource DeviceVolumeTextStyle}"
                       Text="{Binding Default.Volume, Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
